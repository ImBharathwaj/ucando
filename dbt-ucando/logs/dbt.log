  create  table "ucando"."dbt"."customer_360__dbt_tmp"
  
  
    as
  
  (
    select distinct 
    customer_id,
    transaction_count,
    total_transaction_amount,
    avg_transaction_amount,
    last_transaction_time,
    behavior_event_count,
    session_count,
    last_behavior_time,
    loan_event_count,
    last_loan_event_time,
    insurance_event_count,
    last_insurance_event_time,
    credit_event_count,
    last_credit_event_time,
    marketing_event_count,
    last_marketing_event_time,
    greatest(
        last_transaction_time,
        last_behavior_time,
        last_loan_event_time,
        last_insurance_event_time,
        last_credit_event_time,
        last_marketing_event_time
    ) as last_activity_time

from "ucando"."dbt"."int_customer_activity"
  );
  
