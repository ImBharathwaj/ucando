  create  table "ucando"."dbt"."int_customer_activity__dbt_tmp"
  
  
    as
  
  (
    with activity as (
    select
        customer_id,
        last_transaction_at,
        last_behavior_at,
        last_marketing_event_at,
        last_credit_event_at
    from "ucando"."dbt"."int_customer_transactions" t
    full outer join "ucando"."dbt"."int_customer_behavior" b
        using (customer_id)
)
select
    customer_id,
    last_transaction_at,
    last_behavior_at,
    last_marketing_event_at,
    last_credit_event_at,
    greatest(
        last_transaction_at,
        last_behavior_at,
        last_marketing_event_at,
        last_credit_event_at
    ) as last_activity_at
from activity
  );
  
