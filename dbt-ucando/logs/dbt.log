  create  table "ucando"."dbt"."int_customer_activity__dbt_tmp"
  
  
    as
  
  (
    with customers as (
    select distinct customer_id
    from "ucando"."dbt_stage"."stg_transactions"

    union

    select distinct customer_id
    from "ucando"."dbt_stage"."stg_behavior"

    union

    select distinct customer_id
    from "ucando"."dbt_stage"."stg_loans"

    union

    select distinct customer_id
    from "ucando"."dbt_stage"."stg_insurance"

    union

    select distinct customer_id
    from "ucando"."dbt_stage"."stg_credit"

    union

    select distinct customer_id
    from "ucando"."dbt_stage"."stg_marketing"

    union

    select distinct customer_id
    from "ucando"."dbt_stage"."stg_customer_cdc"
)
, transactions as (
    select 
        customer_id,
        count(1) as transaction_count,
        coalesce(sum(amount),0) as total_transaction_amount,
        coalesce(avg(amount),0) as avg_transaction_amount,
        max(event_time) as last_transaction_time
    from "ucando"."dbt_stage"."stg_transactions"
    group by customer_id
)
,behavior as (

    select
        customer_id,
        count(*) as behavior_event_count,
        count(distinct session_id) as session_count,
        max(event_time) as last_behavior_time
    from "ucando"."dbt_stage"."stg_behavior"
    group by customer_id
)
,loans as (

    select
        customer_id,
        count(*) as loan_event_count,
        max(event_time) as last_loan_event_time
    from "ucando"."dbt_stage"."stg_loans"
    group by customer_id
),

insurance as (

    select
        customer_id,
        count(*) as insurance_event_count,
        max(event_time) as last_insurance_event_time
    from "ucando"."dbt_stage"."stg_insurance"
    group by customer_id
),

credit as (

    select
        customer_id,
        count(*) as credit_event_count,
        max(event_time) as last_credit_event_time
    from "ucando"."dbt_stage"."stg_credit"
    group by customer_id
),

marketing as (

    select
        customer_id,
        count(*) as marketing_event_count,
        max(event_time) as last_marketing_event_time
    from "ucando"."dbt_stage"."stg_marketing"
    group by customer_id
)

select
    c.customer_id,
    coalesce(t.transaction_count, 0) as transaction_count,
    coalesce(t.total_transaction_amount, 0) as total_transaction_amount,
    coalesce(t.avg_transaction_amount, 0) as avg_transaction_amount,
    t.last_transaction_time,
    coalesce(b.behavior_event_count, 0) as behavior_event_count,
    coalesce(b.session_count, 0) as session_count,
    b.last_behavior_time,
    coalesce(l.loan_event_count, 0) as loan_event_count,
    l.last_loan_event_time,
    coalesce(i.insurance_event_count, 0) as insurance_event_count,
    i.last_insurance_event_time,
    coalesce(cr.credit_event_count, 0) as credit_event_count,
    cr.last_credit_event_time,
    coalesce(m.marketing_event_count, 0) as marketing_event_count,
    m.last_marketing_event_time
from customers c
left join transactions t on c.customer_id = t.customer_id
left join behavior b on c.customer_id = b.customer_id
left join loans l on c.customer_id = l.customer_id
left join insurance i on c.customer_id = i.customer_id 
left join credit cr on c.customer_id = cr.customer_id
left join marketing m on c.customer_id = m.customer_id
  );
  
